# Скопіюйте в .env (не комітиться, див. .gitignore) і заповніть реальними значеннями.

# Railway Postgres (Settings -> Variables -> DATABASE_PUBLIC_URL). Без цієї змінної застосунок
# сам падає на локальний SQLite-файл (%LOCALAPPDATA%\Ryatuvalnychok\app.db) — зручно для
# розробки, але для реального деплою на Railway ОБОВ'ЯЗКОВО задати цю змінну.
DATABASE_PUBLIC_URL=

# Ключ підпису Flask-сесій (Flask-Login). Згенерувати: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Fernet-ключ для шифрування IG-токенів/Anthropic-ключів у БД (app/crypto.py). Згенерувати:
# python -c "from app.crypto import generate_key; print(generate_key())"
# ВТРАТА цього ключа = втрата можливості розшифрувати всі секрети в БД. Ніколи не комітити.
ENCRYPTION_KEY=

FLASK_APP=app:create_app
