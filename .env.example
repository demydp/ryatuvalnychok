# Скопіюйте в .env (не комітиться, див. .gitignore) і заповніть реальними значеннями.
# На Render ці ж імена задаються як звичайні Environment Variables у налаштуваннях сервісу —
# Render НЕ читає .env-файл з репозиторію, .env працює лише для локальної розробки
# (python-dotenv).

# Neon Postgres connection string (Neon Dashboard -> Connection Details -> Connection string;
# зазвичай з ?sslmode=require). Задається на Render як DATABASE_URL. DATABASE_PUBLIC_URL теж
# підтримується як legacy-alias (мав пріоритет над DATABASE_URL на Railway, app/db.py) — для
# нового деплою на Render/Neon достатньо DATABASE_URL. Без жодної з двох застосунок сам падає
# на локальний SQLite-файл (%LOCALAPPDATA%\Ryatuvalnychok\app.db) — зручно для розробки, але
# для реального деплою ОБОВ'ЯЗКОВО задати DATABASE_URL.
DATABASE_URL=

# Ключ підпису Flask-сесій (Flask-Login) — БЕЗ НЬОГО НЕ СТАРТУЄ НА ПРОДІ (app/__init__.py
# падає ще на старті процесу, якщо DATABASE_PUBLIC_URL/DATABASE_URL задано, а SECRET_KEY нема).
# Згенерувати: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Fernet-ключ для шифрування IG-токенів/Anthropic-ключів у БД (app/crypto.py) — теж
# ОБОВ'ЯЗКОВИЙ на проді (та сама поведінка: падає на старті, якщо його нема). Згенерувати:
# python -c "from app.crypto import generate_key; print(generate_key())"
# ВТРАТА цього ключа = втрата можливості розшифрувати всі секрети в БД. Ніколи не комітити.
ENCRYPTION_KEY=

# Потрібен і локально (flask run/flask db upgrade), і на Render (Pre-Deploy Command або Start
# Command викликає `flask db upgrade` перед стартом — команді `flask` потрібен FLASK_APP в
# оточенні ДО того, як застосунок взагалі імпортується, .env-файл на це запізно, тому на
# Render задайте FLASK_APP окремою Environment Variable, а не покладайтесь на цей файл).
FLASK_APP=app:create_app

# TikTok for Developers (Login Kit OAuth v2 + Display API) — Client Key/Secret застосунку
# власника з developers.tiktok.com/apps, ОБОВ'ЯЗКОВІ для кнопки "Підключити TikTok" у
# Настройках (app/tiktok_api.py падає чіткою помилкою на спробі підключення, якщо їх нема,
# застосунок при цьому не падає при старті — TikTok опційний). TIKTOK_REDIRECT_URI має
# збігатися СИМВОЛ-У-СИМВОЛ із тим, що вписано в TikTok Developer Portal (Redirect URI) —
# формат https://<ваш-домен-на-render>/api/tiktok/callback.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Опційно: якщо колись знадобиться кілька gunicorn-воркерів АБО окремий процес-планувальник —
# задайте RUN_SCHEDULER=0 на всіх процесах/воркерах, КРІМ одного (див. app/scheduler.py) —
# інакше фонові job'и (продовження токена, денний звіт, авто-синк) продублюються. Render Start
# Command навмисно тримає --workers 1, тому за замовчуванням (RUN_SCHEDULER не задано) все
# коректно й без цієї змінної.
RUN_SCHEDULER=
